{
  "name": "wifi-guard",
  "version": "1.0.0",
  "type": "module",
  "description": "Professional Network Device Monitor and Router Access Guard",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "electron-builder --dir",
    "package:win": "electron-builder --win",
    "test": "vitest run",
    "router:diagnose": "tsx scripts/diagnose.ts",
    "router:read": "tsx scripts/read-clients.ts",
    "router:block-test": "tsx scripts/block-test.ts",
    "router:unblock-test": "tsx scripts/unblock-test.ts"
  },
  "keywords": [
    "wifi",
    "router",
    "network-monitor",
    "security",
    "mac-filtering",
    "fiberhome"
  ],
  "author": "WiFi Guard Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/crypto-js": "^4.2.2",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.wifiguard.app",
    "productName": "WiFi Guard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
